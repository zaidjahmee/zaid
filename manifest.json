{
  "name": "Ledger — Shift & Sales Tracker",
  "short_name": "Ledger",
  "description": "Daily inventory counts, sales totals, cash reconciliation, and employee shift tracking across multiple stores.",
  "id": "/index.html",
  "start_url": "/index.html",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait",
  "background_color": "#171310",
  "theme_color": "#171310",
  "lang": "en-US",
  "dir": "ltr",
  "categories": ["business", "productivity", "utilities"],
  "prefer_related_applications": false,
  "related_applications": [],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "screenshot-1.png", "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "Daily sheet with live totals" },
    { "src": "screenshot-2.png", "sizes": "1920x1080", "type": "image/png", "form_factor": "wide", "label": "Week totals across all stores" }
  ],
  "shortcuts": [
    {
      "name": "Today's Sheet",
      "short_name": "Sheet",
      "description": "Jump straight to today's inventory sheet",
      "url": "/index.html?view=sheet",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Week Totals",
      "short_name": "Week",
      "description": "See this week's totals across all stores",
      "url": "/index.html?view=week",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "History",
      "short_name": "History",
      "description": "Browse past days",
      "url": "/index.html?view=history",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192" }]
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "edge_side_panel": {
    "preferred_width": 420
  }
}
